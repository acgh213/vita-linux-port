#!/bin/sh
# Wait for mlan0 (mwifiex async probe) then bring up WiFi.
# Runs in background so it does not block other init scripts.
# Keep progress on tty0: HDMI is the ground-truth discriminator when the
# network is dark and the PSTV has no UART header.

IFACE=mlan0
TIMEOUT=30

case "$1" in
start)
    (
        exec > /dev/tty0 2>&1
        echo "[wifi] === debug boot: waiting for $IFACE ==="
        i=0
        while [ $i -lt $TIMEOUT ]; do
            if [ -d /sys/class/net/$IFACE ]; then
                echo "[wifi] $IFACE present after ${i}s"
                break
            fi
            sleep 1
            i=$((i + 1))
        done
        if [ -d /sys/class/net/$IFACE ]; then
            echo "[wifi] bringing up $IFACE (ifup)..."
            /sbin/ifup $IFACE 2>&1
            echo "[wifi] ifup exit: $?"
            sleep 2
            echo "[wifi] mlan0 addr: $(ip -4 addr show $IFACE 2>/dev/null | grep inet || echo NONE)"
            echo "[wifi] carrier: $(cat /sys/class/net/$IFACE/carrier 2>/dev/null || echo N/A)"
            echo "[wifi] === done. Final: ==="
            ip addr show $IFACE 2>&1 | grep -E '^[0-9]+:|inet ' || true
        else
            echo "[wifi] $IFACE not found after ${TIMEOUT}s"
        fi
    ) &
    echo "OK (background)"
    ;;
stop)
    /sbin/ifdown $IFACE 2>/dev/null
    killall wpa_supplicant 2>/dev/null
    echo "OK"
    ;;
*)
    echo "Usage: $0 {start|stop}"
    ;;
esac
