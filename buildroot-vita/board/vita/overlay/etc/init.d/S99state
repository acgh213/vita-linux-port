#!/bin/sh
# S99state — 45s-after-boot state summary on tty0 (HDMI). Headless bring-up
# aid: confirms userspace actually finished booting even when the network
# path is dark. Recovered verbatim from the proven ed6081d8 rootfs
# (2026-08-17 bring-up kit), where it existed only as a manual repack step.
case "$1" in
start)
    (
        exec > /dev/tty0 2>&1
        sleep 45
        echo "[state] === final state at $(date +%T) ==="
        echo "[state] interfaces: $(ls /sys/class/net 2>/dev/null | tr '\n' ' ')"
        ip addr show 2>&1 | grep -E '^[0-9]+:|inet ' || true
        echo "[state] wireless: $(cat /proc/net/wireless 2>/dev/null | tail -2 | tr '\n' ' ')"
        echo "[state] processes: $(ls /proc | grep -c '^[0-9]')"
        echo "[state] === end ==="
    ) &
    ;;
stop) ;;
esac
